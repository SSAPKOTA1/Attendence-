NODE_ENV=development
PORT=3000
# reverse proxies in front of the app (number of hops, or 'loopback')
TRUST_PROXY=loopback
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shiftsched
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# console | smtp | memory | disabled  (console/disabled return invite links in responses)
MAIL_MODE=console
SMTP_URL=
MAIL_FROM=no-reply@example.com
BCRYPT_COST=12
LOG_LEVEL=info
JOBS_ENABLED=true
COOKIE_SECURE=true
RATE_LIMIT_USER_PER_MIN=100
LOGIN_RATE_LIMIT=5
KIOSK_RATE_LIMIT=60
